<style>
    .billingo-metabox-holder {
        background-color: #FFF;
        min-width: auto;
        min-height: min-content;
    }

    .billingo-postbox {
        padding: 20px;
        background: #FFFFFF;
        min-width: auto;
    }


    .billingo-field-description-italic {
        width: 514px;
        height: 16px;

        font-family: 'Arial';
        font-style: italic;
        font-weight: 400;
        font-size: 14px;
        line-height: 16px;
        /* identical to box height */

        /* mg3/mg3 text light */
        color: #8B9FB0;
        text-decoration: none;

        /* Inside auto layout */
        flex: none;
        order: 0;
        flex-grow: 0;

    }

    .billingo-description-container {
        /* Frame 16 */

        /* Auto layout */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 0px 40px 10px 0px;
        gap: 10px;

        width: 1220px;
        height: 160px;


        /* Inside auto layout */
        flex: none;

        flex-grow: 0;
        z-index: 5;

    }



    .billingo-description-long-italic {
        display: flex;

        font-family: 'Arial';
        font-style: italic;
        font-weight: 400;
        font-size: 14px;
        line-height: 16px;
        /* identical to box height */

        /* mg3/mg3 text light */
        color: #8B9FB0;
        text-decoration: none;

        /* Inside auto layout */
        flex: none;
        order: 0;
        flex-grow: 0;
    }


    .billingo-settings-title-support {

        /* Auto layout */
        display: flex;
        flex-direction: row;

        align-items: center;
        padding: 0px;
        gap: 10px;

        width: 131px;
        height: 30px;


        /* Inside auto layout */
        flex: none;
        order: 1;
        flex-grow: 0;
        z-index: 1;

        font-family: Arial;
        font-weight: 700;
        font-size: 18px;
        line-height: 100%;
        letter-spacing: 0%;
        color: #10355A;

    }


    .billingo-field-name {
        width: 85px;
        height: 16px;

        font-family: 'Arial';
        font-style: normal;
        font-weight: 700;
        font-size: 14px;
        line-height: 16px;
        /* identical to box height */

        /* mg/mg-d */
        color: #0C2542 !important;


        /* Inside auto layout */
        flex: none;
        order: 0;
        flex-grow: 1;

    }

    /* Row and column layout */
    .row {
        display: flex;
        flex-direction: row;
        width: 100%;
    }

    .column {
        display: flex;
        flex-direction: column;
    }

    .column:first-child {
        flex: 1;
    }

    .column:last-child {
        width: 300px;
        justify-content: center;
        align-items: center;
    }


    .billingo-secondary-btn {
        /* type=Secondary */

        box-sizing: border-box;

        /* Auto layout */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 7px 10px;
        gap: 4px;

        position: absolute;
        width: 79px;
        height: 30px;
        left: 20px;
        top: 70px;

        background: #FFFFFF;
        border: 1px solid #8D8F95;
        border-radius: 3px;

    }


    .billingo-support-settings-field-name-container {
        display: flex;
        gap: 10px;


        width: 150px;
        height: 30px;


    }

    .billingo-support-textarea {
        width: 440px !important;
        min-height: 120px !important;
        background-color: #FFFFFF !important;
        min-width: auto !important;
    }

    .billingo-support-debug-code-cliboard-container {
        padding-right: 0px !important;
        width: 170px !important;
    }

    .billingo-support-contact-container {
        /* Frame 61 */

        /* Auto layout */
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 0px;
        gap: 30px;

        width: 1200px;
        height: 64px;


        /* Inside auto layout */
        flex: none;
        order: 6;
        align-self: stretch;
        flex-grow: 0;
        z-index: 6;

    }

    .woocommerce-save-button.components-button.is-primary {
        display: none !important;
    }


    .billingo-secondary-button {
        /* type=Secondary */

        box-sizing: border-box;

        /* Auto layout */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 7px 10px;
        gap: 4px;


        width: fit-content;
        height: fit-content;
        left: 20px;
        top: 70px;
        text-decoration: none !important;
        color: inherit !important;


        background: #FFFFFF;
        border: 1px solid #8D8F95;
        border-radius: 3px;



        font-family: 'Arial';
        font-style: normal;
        font-weight: 700;
        font-size: 14px;
        line-height: 16px;
        /* identical to box height */

        color: #50565F;


        /* Inside auto layout */
        flex: none;
        order: 0;
        align-self: stretch;
        flex-grow: 0;


    }
    
    /* Responsive CSS for mobile devices */
    @media screen and (max-width: 1440px) {
        .billingo-description-container {
            width: 100%;
            padding: 0 20px 10px;
            height: auto;
            min-height: 160px;
        }
        
        .billingo-support-contact-container {
            width: 100%;
            flex-wrap: wrap;
            height: auto;
            min-height: 64px;
            padding: 15px 0;
        }
        
        .billingo-support-contact-container .flex {
            width: 100%;
        }
        
        .billingo-support-contact-container .row {
            flex-wrap: wrap;
            justify-content: flex-start;
            align-items: center;
            width: 100%;
            gap: 15px;
        }
    }

    @media (max-width: 1199px) {
    .billingo-illustration svg {
      display: none;
    }
  }
    
    @media screen and (max-width: 782px) {
        .billingo-metabox-holder {
            padding: 0 10px;
            min-width: auto;
            width: 100%;
        }
        
        .billingo-postbox {
            padding: 15px 10px;
            min-width: auto;
            width: 100%;
        }
        
        /* Make rows flex column on mobile */
        .row {
            flex-direction: column;
        }
        
        .column:first-child {
            min-width: auto !important;
            max-width: 100% !important;
            width: 100% !important;
        }
        
        /* Adjust table for mobile */
        .form-table, 
        .form-table tbody, 
        .form-table tr, 
        .form-table th, 
        .form-table td {
            display: block;
            width: 100%;
            box-sizing: border-box;
        }
        
        .form-table th {
            padding-bottom: 5px;
        }
        
        .form-table td {
            padding-top: 0;
            padding-bottom: 15px;
        }
        
        /* Fix input widths */
        .billingo-support-textarea {
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            min-height: 120px !important;
            box-sizing: border-box;
        }
        
        /* Fix description text */
        .billingo-field-description-italic {
            width: 100%;
            height: auto;
            margin-top: 5px;
            line-height: 1.4;
            padding-right: 0 !important;
        }
        
        .billingo-support-debug-code-cliboard-container {
            width: 100% !important;
            padding: 0 !important;
        }
        
        .billingo-support-settings-field-name-container {
            width: 100%;
            justify-content: space-between;
            height: auto;
            min-height: 30px;
        }
        
        /* Description container */
        .billingo-description-container {
            width: 100%;
            height: auto;
            padding: 30px 10px 10px 10px;
        }
        
        .billingo-description-long-italic {
            width: 100%;
            height: auto;
            line-height: 1.5;
            margin-bottom: 10px;
            text-align: center;
        }
        
        /* Buttons container */
        .billingo-support-contact-container {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
            padding: 10px 0;
        }
        
        .billingo-support-contact-container .row {
            width: 100%;
            flex-direction: column;
            gap: 10px;
        }
        
        .billingo-secondary-button {
            width: 100%;
            margin: 5px 0;
            text-align: center;
        }
        
        /* Center title on mobile */
        .billingo-settings-title-support {
            width: 100%;
            margin: 0 auto 20px auto;
            justify-content: center;
        }

        .billingo-illustration {
            display: none;
        }
        
        h3 {
            font-size: 16px;
            margin: 15px 0 10px;
            width: 100%;
        }
        
        .flex {
            width: 100%;
        }
        
        .flex .row {
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: 100%;
        }
    }
    
    @media screen and (max-width: 480px) {
        .billingo-metabox-holder,
        .billingo-postbox {
            padding: 10px 5px;
            min-width: 0;
            width: 100%;
            overflow-x: hidden;
        }
        
        .form-table th, 
        .form-table td {
            padding: 8px 0;
        }
        
        .billingo-field-description-italic,
        .billingo-description-long-italic,
        .billingo-field-name,
        .billingo-secondary-button {
            font-size: 13px;
        }
        
        .billingo-support-textarea {
            min-height: 100px !important;
            font-size: 13px;
            width: 100% !important;
            min-width: 0 !important;
            padding: 8px;
            box-sizing: border-box;
        }
        
        .column {
            min-width: 0 !important;
            width: 100% !important;
        }
        
        .billingo-support-contact-container {
            padding: 5px 0;
            gap: 8px;
        }
        
        .billingo-support-contact-container .row {
            gap: 8px;
        }
        
        h3 {
            font-size: 15px;
            margin: 10px 0 5px;
            padding-top: 10px !important;
        }
        
        .inside {
            padding: 0 5px;
            margin: 0;
        }
        
        .billingo-settings-title-support {
            font-size: 17px;
            margin-bottom: 15px;
        }
    }
</style>
<script>
    function copyToClipboard(elementId) {
        const textarea = document.getElementById(elementId);
        if (textarea) {
            textarea.select();
            textarea.setSelectionRange(0, 99999);
            document.execCommand('copy');

            alert('Szöveg vágólapra másolva!');
        }
    }
</script>

