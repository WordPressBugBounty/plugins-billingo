<script>
(function () {
    var key = 'billingo_invoice_open_sections';
    var sections = Array.prototype.slice.call(document.querySelectorAll('details.billingo-section'));
    if (!sections.length) { return; }
    var clicked = null;

    function remember() {
        var ids = sections.filter(function (section) { return section.open; }).map(function (section) { return section.id; });
        try { window.localStorage.setItem(key, ids.join(',')); } catch (e) { /* nem baj */ }
    }

    // Induláskor a legutóbb nyitott szekciók, vagy az alapértelmezett.
    var saved = null;
    try { saved = window.localStorage.getItem(key); } catch (e) { saved = null; }
    if (saved !== null) {
        var ids = saved.split(',');
        sections.forEach(function (section) { section.open = ids.indexOf(section.id) !== -1; });
    }

    sections.forEach(function (section) {
        var summary = section.querySelector('summary');

        // Egérkattintásra ne kapjon fókuszkeretet; billentyűzettel (Tab) továbbra is látszik.
        summary.addEventListener('mousedown', function (event) { event.preventDefault(); });
        summary.addEventListener('click', function () { clicked = section; });

        section.addEventListener('toggle', function () {
            // Harmonika: csak a saját kattintás csukja be a többit, a "Mindet kinyit" nem.
            if (section.open && clicked === section) {
                sections.forEach(function (other) {
                    if (other !== section) { other.open = false; }
                });
                window.requestAnimationFrame(function () {
                    if (summary.getBoundingClientRect().top < 0) {
                        summary.scrollIntoView({ block: 'start' });
                    }
                });
            }
            if (clicked === section) { clicked = null; }
            remember();
        });
    });

    Array.prototype.forEach.call(document.querySelectorAll('[data-billingo-sections]'), function (button) {
        button.addEventListener('click', function () {
            var open = button.getAttribute('data-billingo-sections') === 'open';
            clicked = null;
            sections.forEach(function (section) { section.open = open; });
        });
    });
})();
</script>